{
  "name": "@psionic-labs/opencode-agent-causality",
  "version": "0.1.7",
  "description": "OpenCode plugin that streams Agent-Causality telemetry events to the ingest endpoint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Psionic-labs/Agent-Causality.git",
    "directory": "packages/opencode-agent-causality"
  },
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/index.test.mjs test/telemetry.test.mjs test/loader-compat.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.34"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.34",
    "@types/node": "^20.0.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18"
  }
}
